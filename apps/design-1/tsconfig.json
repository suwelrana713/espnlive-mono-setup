{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/components/*": ["../../packages/shared/components/*"],
      "@/lib/*": ["../../packages/shared/lib/*"],
      "@/hooks/*": ["../../packages/shared/hooks/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "../../packages/shared/**/*.ts",
    "../../packages/shared/**/*.tsx"
  ],
  "exclude": ["node_modules", ".next"]
}
