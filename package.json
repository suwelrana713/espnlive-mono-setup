{
  "name": "espnlive-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" --parallel dev",
    "kill": "for p in 5001 5002 5003 5004 5005; do pids=$(lsof -ti tcp:$p 2>/dev/null); [ -n \"$pids\" ] && echo \"port $p -> $pids\" && kill -9 $pids; done; echo done",
    "build": "pnpm --filter \"./apps/*\" -r build",
    "start": "pnpm --filter \"./apps/*\" --parallel start",
    "lint": "pnpm -r lint",
    "dev:design-1": "pnpm --filter design-1 dev",
    "dev:design-2": "pnpm --filter design-2 dev",
    "dev:design-3": "pnpm --filter design-3 dev",
    "dev:design-4": "pnpm --filter design-4 dev",
    "dev:design-5": "pnpm --filter design-5 dev",
    "build:design-1": "pnpm --filter design-1 build",
    "build:design-2": "pnpm --filter design-2 build",
    "build:design-3": "pnpm --filter design-3 build",
    "build:design-4": "pnpm --filter design-4 build",
    "build:design-5": "pnpm --filter design-5 build"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.0.0"
}
